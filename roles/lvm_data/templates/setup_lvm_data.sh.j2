#!/bin/bash
# ============================================================
# Ansible-managed: create LVM data disks on DingoFS meta server nodes
#
# Policy:
#   - Pick the {{ lvm_data_mount_count }} largest unused NVMe devices. One VG per
#     device ({{ lvm_data_vg_prefix }}<offset> .. <offset+N-1>), one
#     {{ lvm_data_lv_name }} LV per VG, formatted {{ lvm_data_fs_type }}, mounted at
#     {{ lvm_data_mount_prefix }}<offset> .. {{ lvm_data_mount_prefix }}<offset+N-1>.
#   - Index starts at lvm_data_mount_index_offset ({{ lvm_data_mount_index_offset }}).
#     0 matches ${service_replica_sequence}; 1 matches
#     ${service_replica_sequence_with_offset} with sequence_offset: 1.
#     ⚠️ It must match the topology's sequence_offset. If they disagree the data
#        directories land on unmounted indices (i.e. on the system disk), and
#        the "which indices still need creating" test below goes wrong: with 0
#        on a 1-based host this script thinks {{ lvm_data_mount_prefix }}0 is
#        missing and goes looking for a free NVMe to pvcreate.
#   - Remaining disks are left untouched.
#   - Idempotent: already-mounted indices are skipped, only missing ones are created.
#
# Do not use bash array-length syntax (dollar-brace-hash) anywhere in this file:
# the hash is parsed by ansible as a jinja2 comment opener and breaks rendering.
# Counters are used instead. lvm_cache hit the same issue.
# ============================================================

set -o pipefail

MOUNT_COUNT={{ lvm_data_mount_count | int }}
# First disk index. 0 = /mnt/disk0..N-1 (bj12); 1 = /mnt/disk1..N (bj09 and
# everything else, disks allocated by hand starting at 1).
# Must match the topology's sequence_offset.
MOUNT_OFFSET={{ lvm_data_mount_index_offset | int }}
MOUNT_END=$((MOUNT_OFFSET + MOUNT_COUNT))
MIN_BYTES={{ lvm_data_min_disk_gb | int * 1000000000 }}
PREFIX="{{ lvm_data_mount_prefix }}"

# Refuse to hide files when mounting a new or recovered LV.
require_empty_target() {
    local target="$1"
    if [ -d "$target" ] && [ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
        echo "Error: $target contains files; refusing to hide them under a mount" >&2
        exit 1
    fi
}

# --- Recover existing managed volumes BEFORE considering any new disk ---
i="$MOUNT_OFFSET"
while [ "$i" -lt "$MOUNT_END" ]; do
    vg="{{ lvm_data_vg_prefix }}${i}"
    lv="/dev/$vg/{{ lvm_data_lv_name }}"
    target="${PREFIX}${i}"
    if vgs "$vg" >/dev/null 2>&1; then
        actual=$(findmnt -rno SOURCE --mountpoint "$target" 2>/dev/null)
        if [ -n "$actual" ] && [ "$(readlink -f "$actual")" != "$(readlink -f "$lv")" ]; then
            echo "Error: $target is occupied by $actual, expected $lv" >&2; exit 1
        fi
        uuid=$(blkid -o value -s UUID "$lv" 2>/dev/null)
        if [ -z "$actual" ] || ! awk -v t="$target" -v u="UUID=$uuid" -v l="$lv" '$1 !~ /^#/ && $2 == t && ($1 == u || $1 == l) {found=1} END {exit !found}' /etc/fstab; then
            if [ "{{ lvm_data_repair | default(false) | bool | lower }}" != true ]; then
                echo "HALF-PROVISIONED: $vg exists but its mount or fstab entry is missing. Re-run with lvm_data_repair=true; no new disk will be formatted." >&2
                exit 1
            fi
            vgchange -ay "$vg" || exit 1
            fs=$(blkid -o value -s TYPE "$lv" 2>/dev/null)
            uuid=$(blkid -o value -s UUID "$lv" 2>/dev/null)
            if [ "$fs" != "{{ lvm_data_fs_type }}" ] || [ -z "$uuid" ]; then
                echo "Error: $lv has no verified {{ lvm_data_fs_type }} filesystem; recover manually. Repair never formats existing volumes." >&2; exit 1
            fi
            if awk -v t="$target" -v u="UUID=$uuid" -v l="$lv" '$1 !~ /^#/ && $2 == t && $1 != u && $1 != l {conflict=1} END {exit !conflict}' /etc/fstab; then
                echo "Error: conflicting fstab entry for $target" >&2; exit 1
            fi
            if [ -z "$actual" ]; then
                require_empty_target "$target"
                mkdir -p "$target" || exit 1
                mount "$lv" "$target" || exit 1
            fi
            if ! awk -v t="$target" '$1 !~ /^#/ && $2 == t {found=1} END {exit !found}' /etc/fstab; then
                printf 'UUID=%s %s {{ lvm_data_fs_type }} defaults,noatime 0 0\n' "$uuid" "$target" >> /etc/fstab || exit 1
            fi
            echo "Done: recovered $lv at $target without formatting"
        fi
    fi
    i=$((i + 1))
done

# --- 1. Which mount indices still need creating ---
echo "=== Checking existing mounts ==="
pending_indices=()
i="$MOUNT_OFFSET"
while [ "$i" -lt "$MOUNT_END" ]; do
    target="${PREFIX}${i}"
    if findmnt -rno SOURCE --mountpoint "$target" >/dev/null 2>&1; then
        echo "  ${target} already mounted ($(findmnt -rno SOURCE --mountpoint "$target")), skipping"
    else
        require_empty_target "$target"
        if awk -v t="$target" '$1 !~ /^#/ && $2 == t {found=1} END {exit !found}' /etc/fstab; then
            echo "Error: $target already has an fstab entry; recover its existing filesystem instead of allocating a new disk" >&2; exit 1
        fi
        echo "  ${target} not mounted, will create"
        pending_indices+=("$i")
    fi
    i=$((i + 1))
done

pending_count=0
for _ in "${pending_indices[@]}"; do
    pending_count=$((pending_count + 1))
done

if [ "$pending_count" -eq 0 ]; then
    echo "==> All $MOUNT_COUNT data mounts are present, nothing to do"
    exit 0
fi

# --- 2. Detect unused NVMe devices ---
echo ""
echo "=== Detecting unused NVMe devices ==="
devices=$(lsblk -lno NAME | grep '^nvme[0-9]\+n[0-9]\+$')

records=()
candidate_count=0

for dev in $devices; do
    path="/dev/$dev"

    # skip if mounted (device or any partition)
    if lsblk -rno MOUNTPOINT "$path" | grep -qv '^$'; then
        echo "  Skipping $path (mounted)"
        continue
    fi

    # skip if already in a {{ lvm_data_vg_prefix }} VG
    if pvs --noheadings -o vg_name "$path" 2>/dev/null | grep -q '{{ lvm_data_vg_prefix }}'; then
        echo "  Skipping $path (already in a {{ lvm_data_vg_prefix }} VG)"
        continue
    fi

{% for vg in lvm_data_skip_vg_names %}
    if pvs --noheadings -o vg_name "$path" 2>/dev/null | grep -qw "{{ vg }}"; then
        echo "  Skipping $path (in VG {{ vg }})"
        continue
    fi
{% endfor %}

    # Safety gate: never format a device that already has a filesystem
    # signature or partitions. Set lvm_data_force=true to override.
    if [ "{{ lvm_data_force | bool | lower }}" != "true" ]; then
        if blkid "$path" >/dev/null 2>&1; then
            echo "  Skipping $path (has fs signature: $(blkid -o value -s TYPE "$path" 2>/dev/null); set lvm_data_force=true to wipe)"
            continue
        fi
        if [ -n "$(lsblk -rno NAME "$path" | tail -n +2)" ]; then
            echo "  Skipping $path (has a partition table; set lvm_data_force=true to wipe)"
            continue
        fi
    fi

    size_bytes=$(blockdev --getsize64 "$path") || { echo "Error: cannot read size of $path"; exit 1; }
    if [ "$size_bytes" -lt "$MIN_BYTES" ]; then
        echo "  Skipping $path ($((size_bytes / 1000000000))GB < {{ lvm_data_min_disk_gb }}GB)"
        continue
    fi

    size=$(numfmt --to=iec --format %.1f "$size_bytes")
    echo "  Usable data disk $path ($size)"
    records+=("$size_bytes $path")
    candidate_count=$((candidate_count + 1))
done

if [ "$candidate_count" -lt "$pending_count" ]; then
    echo "Error: need $pending_count more disks but only found $candidate_count unused NVMe devices" >&2
    exit 1
fi

# --- 3. Sort by size descending, take the first pending_count ---
IFS=$'\n'
sorted_records=($(printf '%s\n' "${records[@]}" | sort -k1,1nr -k2,2))
unset IFS

# --- 4. Create VG/LV and mount ---
echo ""
echo "=== Creating data disk LVM ==="
idx=0
for record in "${sorted_records[@]}"; do
    if [ "$idx" -ge "$pending_count" ]; then
        break
    fi

    device="${record#* }"
    index="${pending_indices[$idx]}"
    vg_name="{{ lvm_data_vg_prefix }}${index}"
    mount_point="${PREFIX}${index}"

    echo "Processing: $device -> VG $vg_name -> $mount_point"

    # Any failure exits non-zero so ansible reports FAILED rather than
    # masking it behind a final "completed" message.
    pvcreate -y -ff "$device"                    || { echo "Error: pvcreate $device failed" >&2; exit 1; }
    vgcreate "$vg_name" "$device"                || { echo "Error: vgcreate $vg_name failed" >&2; exit 1; }
    lvcreate -y -l 100%FREE -n {{ lvm_data_lv_name }} "$vg_name" \
                                                 || { echo "Error: lvcreate $vg_name failed" >&2; exit 1; }
    mkfs.{{ lvm_data_fs_type }} "/dev/${vg_name}/{{ lvm_data_lv_name }}" \
                                                 || { echo "Error: mkfs $vg_name failed" >&2; exit 1; }

    mkdir -p "$mount_point"
    mount "/dev/${vg_name}/{{ lvm_data_lv_name }}" "$mount_point" \
                                                 || { echo "Error: mount $mount_point failed" >&2; exit 1; }

    # Mount by UUID so device renames cannot shift the layout.
    uuid=$(blkid -o value -s UUID "/dev/${vg_name}/{{ lvm_data_lv_name }}")
    if [ -z "$uuid" ]; then
        echo "Error: cannot read UUID of $vg_name" >&2; exit 1
    fi
    sed -i "\#${mount_point} #d" /etc/fstab
    printf 'UUID=%s %s {{ lvm_data_fs_type }} defaults,noatime 0 0\n' "$uuid" "$mount_point" >> /etc/fstab

    echo "  Done: $device -> $mount_point"
    echo ""
    idx=$((idx + 1))
done

# --- 5. Summary ---
echo "=== Final layout ==="
i="$MOUNT_OFFSET"
while [ "$i" -lt "$MOUNT_END" ]; do
    target="${PREFIX}${i}"
    if findmnt -rno SOURCE --mountpoint "$target" >/dev/null 2>&1; then
        avail=$(df -h --output=avail "$target" 2>/dev/null | tail -1 | tr -d ' ')
        printf '  %-16s <- %-28s avail %s\n' "$target" "$(findmnt -rno SOURCE --mountpoint "$target")" "$avail"
    else
        printf '  %-16s <- not mounted\n' "$target"
    fi
    i=$((i + 1))
done

echo ""
echo "=== DingoFS meta data disk LVM setup completed ==="
