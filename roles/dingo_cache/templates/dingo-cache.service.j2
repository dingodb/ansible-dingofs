[Unit]
Description=Dingo Cache System Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
{% if IB_CHECK_ENABLED | default(true) | bool and dingo_cache_use_rdma | default(true) | bool %}
# Wait for the RDMA fabric (ACTIVE port + cluster IPv4) before starting.
# The script checks health from the IP prefix alone; device names are
# detected per host and are not passed to it.
Environment="IB_IP_PREFIX={{ IB_IP_PREFIX | default('192.168.') }}"
Environment="IB_WAIT_TIMEOUT={{ IB_WAIT_TIMEOUT | default(60) }}"
ExecStartPre={{ IB_CHECK_SCRIPT | default('/root/dingofs/script/check/check-ib-ready.sh') }}
# ExecStartPre waiting counts against TimeoutStartSec (default 90s).
TimeoutStartSec={{ (IB_WAIT_TIMEOUT | default(60) | int) + 60 }}
{% endif %}
ExecStart={{ dingo_cache_base_dir }}/dingo-cache-start.sh
Restart=always
RestartSec=30
{% if dingo_cache_cpu_quota | default('') | string | length > 0 %}
CPUQuota={{ dingo_cache_cpu_quota }}
{% endif %}
{% if dingo_cache_memory_high | default('') | string | length > 0 %}
MemoryHigh={{ dingo_cache_memory_high }}
{% endif %}
{% if dingo_cache_memory_max | default('') | string | length > 0 %}
MemoryMax={{ dingo_cache_memory_max }}
{% endif %}
LimitNOFILE=1000000
LimitCORE=infinity
LimitNPROC=4194304

[Install]
WantedBy=multi-user.target
