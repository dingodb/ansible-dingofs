#!/usr/bin/env bash
# Ansible-managed: Dingo-cache startup script

CACHE_CONF_FILE="{{ dingo_cache_base_dir }}/dingo-cache.conf"

if [ ! -f "$CACHE_CONF_FILE" ]; then
    echo "Error: Config file $CACHE_CONF_FILE not found"
    exit 1
fi

# Apply the process policy before worker threads and RDMA buffers are created.
{% set _node = dingo_cache_numactl_node_effective | default('') | string | trim %}
{% set _memory = '--membind=' if dingo_cache_numactl_membind | default(false) | bool else '--preferred=' %}
{% set _numactl = ('numactl --cpunodebind=' ~ _node ~ ' ' ~ _memory ~ _node ~ ' ')
     if (dingo_cache_numactl_enabled | default(true) | bool and _node | length > 0) else '' %}
LD_PRELOAD={{ dingo_cache_ld_preload }} {{ _numactl }}{{ dingo_cache_base_dir }}/{{ dingo_cache_bin_name }} --flagfile "$CACHE_CONF_FILE"
