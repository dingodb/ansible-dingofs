[Unit]
Description=DingoFS Mount {{ dingo_client_fsname }} Service
After=network.target

[Service]
{% if IB_CHECK_ENABLED | default(true) | bool and dingo_client_use_rdma | default(true) | bool %}
# Wait for the RDMA fabric (ACTIVE port + cluster IPv4) before starting.
# Device names are auto-detected by the script; only the IP prefix and the
# timeout are configurable (inventory/group_vars/all.yml).
Environment="IB_IP_PREFIX={{ IB_IP_PREFIX | default('192.168.') }}"
Environment="IB_WAIT_TIMEOUT={{ IB_WAIT_TIMEOUT | default(60) }}"
Environment="RDMA_DEVICE={{ dingo_client_rdma_device_effective | default(dingo_client_rdma_device) }}"
Environment="RDMA_PORT_NUM={{ dingo_client_rdma_port_num }}"
ExecStartPre={{ IB_CHECK_SCRIPT | default('/root/dingofs/script/check/check-ib-ready.sh') }}
# ExecStartPre waiting counts against TimeoutStartSec (default 90s).
TimeoutStartSec={{ (IB_WAIT_TIMEOUT | default(60) | int) + 60 }}
{% endif %}
ExecStart={{ dingo_client_base_dir }}/dingofs-mount.sh
Restart=always
RestartSec=30
LimitNOFILE=1000000
OOMScoreAdjust={{ dingo_client_oom_score_adjust | default(0) }}
LimitCORE=infinity
LimitNPROC=4194304

[Install]
WantedBy=multi-user.target
