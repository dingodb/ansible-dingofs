#!/usr/bin/env bash

g_dingo="{{ dingo_client_base_dir }}/bin/dingo"
g_fuse="{{ dingo_client_base_dir }}/bin/dingo-client"
g_mnt="{{ dingo_client_mount_point }}"
g_fsname="{{ dingo_client_fsname }}"
g_mdsaddr="{{ dingo_client_mds_addrs }}"
g_cache_group="{{ dingo_client_cache_group }}"
g_port="{{ dingo_client_port }}"
g_log="{{ dingo_client_log_dir }}"

echo "Log path is configured to: $g_log"

# Create mount point if absent
if [ ! -d "${g_mnt}" ]; then
    echo "Creating mount point ${g_mnt}..."
    mkdir -p "${g_mnt}"
fi

# Unmount if already mounted
if mountpoint -q "${g_mnt}" 2>/dev/null; then
    umount -l "${g_mnt}"
fi

# Get mountpoint info and umount via dingo CLI
mnt_info=$(${g_dingo} fs mountpoint --mdsaddr=${g_mdsaddr} | grep "${g_mnt}" | grep "$(hostname)")

if [ -z "$mnt_info" ]; then
    echo "No existing mountpoint on $(hostname), skip umount..."
    umount -l "${g_mnt}" 2>/dev/null || true
else
    echo "Umounting existing mountpoint on $(hostname)..."
    metric_port=$(echo "$mnt_info" | awk -F '[:]' '{print $2}')
    echo "mountpoint ${g_mnt} metric_port is ${metric_port}"
    ${g_dingo} fs umount "${g_mnt}"
    if [ $? -ne 0 ]; then
        echo "umount failed, exit..."
        exit 1
    fi
fi

# NUMA binding: bind the whole process (and therefore the jemalloc heap and the
# RDMA buffers) to one NUMA node. The node is dingo_client_numactl_node when
# set, otherwise the node this instance's --cpuset lives on (that cpuset is
# itself a subset of the node, so --cpunodebind never takes CPUs away from it).
# Without a node — pin_cpu off and no explicit override — nothing is bound.
{% set _numactl_node = dingo_client_numactl_node_effective | default('') | string | trim %}
{% set _numactl_mem = '--membind=' if dingo_client_numactl_membind | default(true) | bool else '--preferred=' %}
{% set _numactl = ('numactl --cpunodebind=' ~ _numactl_node ~ ' ' ~ _numactl_mem ~ _numactl_node)
     if (dingo_client_numactl_enabled | default(true) | bool and (_numactl_node | length) > 0) else '' %}
# Both commands sit on the same continued line on purpose: Ansible trims the
# newline right after a template tag, so an if-block here would glue the lines
# together without a working backslash continuation.
LD_PRELOAD={{ dingo_client_ld_preload }} \
    {{ (_numactl ~ ' ') if (_numactl | length) > 0 else '' }}${g_fuse} "mds://${g_mdsaddr}/${g_fsname}" "${g_mnt}" \
    --log_dir=${g_log} \
    --log_level={{ dingo_client_log_level }} \
    --log_v={{ dingo_client_log_v }} \
    --cache_store={{ dingo_client_cache_store }} \
    --cache_group=${g_cache_group} \
    --vfs_read_executor_thread={{ dingo_client_vfs_read_executor_thread }} \
    --vfs_read_buffer_total_mb={{ dingo_client_vfs_read_buffer_total_mb }} \
    --vfs_write_buffer_total_mb={{ dingo_client_vfs_write_buffer_total_mb }} \
    --vfs_compact_buffer_total_mb={{ dingo_client_vfs_compact_buffer_total_mb }} \
    --vfs_dummy_server_port=${g_port} \
    --vfs_prefetch_blocks={{ dingo_client_vfs_prefetch_blocks }} \
    --fuse_max_threads={{ dingo_client_fuse_max_threads }} \
    --fuse_enable_readdir_cache={{ dingo_client_fuse_enable_readdir_cache }} \
    --fuse_attr_cache_timeout_s={{ dingo_client_fuse_attr_cache_timeout_s }} \
    --fuse_entry_cache_timeout_s={{ dingo_client_fuse_entry_cache_timeout_s }} \
    --shards={{ _client_shards | default(dingo_client_shards | default(8)) }} \
    --pin_cpu={{ 'true' if (dingo_client_pin_cpu | default(true) | bool and dingo_client_cpuset_effective | default('') | length > 0 and dingo_client_cpuset_effective != 'NONE') else 'false' }} \
{% if dingo_client_pin_cpu | default(true) | bool and dingo_client_cpuset_effective | default('') | length > 0 and dingo_client_cpuset_effective != 'NONE' %}
    --cpuset={{ dingo_client_cpuset_effective }} \
{% endif %}
    --use_rdma={{ 'true' if dingo_client_use_rdma | default(true) | bool else 'false' }}{% if dingo_client_use_rdma | default(true) | bool %} \
    --cache_rdma_device={{ dingo_client_rdma_device | default('ib6s200p0') }} \
    --cache_rdma_port_num={{ dingo_client_rdma_port_num | default(1) }} \
    --buffer_pool_mb={{ dingo_client_buffer_pool_mb | default(1024) }} \
    --rdma_max_inflight_rpcs={{ dingo_client_rdma_max_inflight_rpcs | default(256) }} \
    --rdma_max_connections={{ dingo_client_rdma_max_connections | default(128) }}{% endif %}
