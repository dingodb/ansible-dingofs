global:
  user: {{ dingofs_user }}
  ssh_port: 22
  private_key_file: {{ dingo_cli_ssh_private_key_file | default(dingofs_home ~ '/.ssh/id_' ~ dingofs_ssh_key_type) }}

hosts:
{% for host in groups['meta_servers'] %}
  - host: {{ host }}
    hostname: {{ hostvars[host].dingofs_service_address | default(hostvars[host]['ansible_host']) }}
{% endfor %}
